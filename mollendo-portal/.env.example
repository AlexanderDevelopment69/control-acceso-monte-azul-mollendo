# Entorno LOCAL — PC de desarrollo. Copiar como mollendo-portal/.env.local.
# En los servidores no se usa: la imagen de Docker fija la URL al compilar.
# URL del mollendo-api NestJS (ver /mollendo-api). El WebSocket del panel de
# vigilancia (/ws/eventos) se deriva de esta misma URL, quitando "/api/v1".
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
