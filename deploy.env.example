# Copiar como .env junto a docker-compose.prod.yml y reemplazar cada valor.
DB_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo
DEVICE_API_KEY=cambiar-por-una-clave-larga
CORS_ORIGIN=http://localhost:3000
ADMIN_SEED_PASSWORD=cambiar
VIGILANCIA_SEED_PASSWORD=cambiar
# Solo donde hay lectores de DNI conectados (ver Registro_Despliegue_MiniPC.md, 8c):
# LECTOR_DNI_INGRESO_DISPOSITIVO=/dev/serial/by-id/usb-...
# LECTOR_DNI_SALIDA_DISPOSITIVO=/dev/serial/by-id/usb-...
# Solo donde hay relés USB para los molinetes (ver Registro_Despliegue_MiniPC.md, 8d):
# RELE_INGRESO_SERIE=ING01
# RELE_SALIDA_SERIE=SAL01
# Hora de la sincronización diaria con los G4 Pro (0 = medianoche, por defecto; off = desactivada):
# G4PRO_HORA_SINCRONIZACION=0
# Servidor en la nube con los molinetes en un controlador de garita (docker-compose.controlador.yml):
# MOLINETES_REMOTOS=true
#
# --- Controlador de garita (mini PC), en controlador.env junto a docker-compose.controlador.yml:
# SERVIDOR_URL=https://accesos.ejemplo.com        (la API en la nube, sin /api/v1)
# DEVICE_API_KEY=la-misma-clave-de-equipos-del-servidor
# LECTOR_DNI_INGRESO_DISPOSITIVO=/dev/serial/by-id/usb-...
# LECTOR_DNI_SALIDA_DISPOSITIVO=/dev/serial/by-id/usb-...
# RELE_INGRESO_SERIE=ING01
# RELE_SALIDA_SERIE=SAL01
