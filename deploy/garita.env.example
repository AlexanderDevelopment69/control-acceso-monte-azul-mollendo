# Entorno GARITA (opcional, hoy no se usa) — la mini PC como servidor completo:
# portal, API, base de datos y respaldos en la garita, con los lectores y relés conectados por USB.
# Es el modo anterior a la nube; queda documentado por si se vuelve a él (ver Registro_Despliegue_MiniPC.md).
# Copiar como .env junto a docker-compose.prod.yml y reemplazar cada valor:
#   docker compose -f docker-compose.prod.yml up -d --build
DB_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo
DEVICE_API_KEY=cambiar-por-una-clave-larga
CORS_ORIGIN=http://localhost:3000
ADMIN_SEED_PASSWORD=cambiar
VIGILANCIA_SEED_PASSWORD=cambiar
# Los molinetes se abren desde este mismo equipo: sin MOLINETES_REMOTOS (o false).
MOLINETES_REMOTOS=false
# Lectores de DNI (ver Registro_Despliegue_MiniPC.md, 8c):
LECTOR_DNI_INGRESO_DISPOSITIVO=/dev/serial/by-id/usb-...
LECTOR_DNI_SALIDA_DISPOSITIVO=/dev/serial/by-id/usb-...
# Relés USB de los molinetes (ver Registro_Despliegue_MiniPC.md, 8d):
RELE_INGRESO_SERIE=ING01
RELE_SALIDA_SERIE=SAL01
# Relés de aviso de ingreso y de salida denegados (contacto seco; opcionales):
RELE_AVISO_INGRESO_SERIE=DEN01
RELE_AVISO_SALIDA_SERIE=DSA01
# RELE_AVISO_PULSO_MS=2000
# Hora de la sincronización diaria con los G4 Pro (0 = medianoche; off = desactivada).
G4PRO_HORA_SINCRONIZACION=0
