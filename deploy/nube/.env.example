# Entorno NUBE — servidor en la nube (Azure, 74.163.89.6, https://accesos.monteazulsur.com.pe): portal, API, base de datos y respaldos.
# Los lectores de DNI y los relés están en el Controlador (PC) del punto de acceso (ver ../controlador).
# En esta carpeta (deploy/nube): copiar como .env y reemplazar cada valor:
#   cp .env.example .env && nano .env
#   docker compose up -d --build
DB_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo
# La misma clave va en el .env del Controlador (PC) (deploy/controlador/.env).
DEVICE_API_KEY=cambiar-por-una-clave-larga
# Número de serie del G4 Pro (etiqueta del equipo o Sistema y APIs); varios, separados por coma.
# Solo esos terminales pueden comunicarse con el servidor.
G4PRO_SN_PERMITIDOS=cambiar
# IP pública de la sede desde donde se conecta el G4 Pro (varias, separadas por coma).
# Vacía = cualquier IP. Ver README antes de cambiarla.
G4PRO_IPS_PERMITIDAS=
# Dominio del portal (HTTPS con certificado automático; ver Caddyfile). Debe apuntar a este servidor.
DOMINIO=accesos.monteazulsur.com.pe
# Dirección pública del portal: la del dominio, con https.
CORS_ORIGIN=https://accesos.monteazulsur.com.pe
ADMIN_SEED_PASSWORD=cambiar
VIGILANCIA_SEED_PASSWORD=cambiar
# Obligatorio en la nube: la orden de abrir los molinetes se manda al controlador.
MOLINETES_REMOTOS=true
# Hora de la sincronización diaria con los G4 Pro (0 = medianoche; off = desactivada).
G4PRO_HORA_SINCRONIZACION=off
# Sin LECTOR_DNI_* ni RELE_*: en la nube no hay equipos conectados por USB.
# Opcionales (ver la guía, anexo B):
# HORA_RESPALDO=04:00          hora del respaldo diario
# DIAS_RESPALDO=30             días que se guardan los respaldos
# PUSH_SDK_DEPURAR=false       true: anota todo lo que envía el G4 Pro
# SWAGGER=false                true: publica /api/docs (solo para revisarla; luego volver a false)
