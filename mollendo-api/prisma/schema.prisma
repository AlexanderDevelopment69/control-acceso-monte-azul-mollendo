// Prisma schema — Sistema de Control de Acceso, Terminal de Mollendo
// Alcance base: ver Especificacion_Desarrollo_Control_Acceso_Mollendo_base.md (sección 8)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums (reflejan los CHECK constraints del script SQL original)
// ---------------------------------------------------------------------

enum EstadoEmpresa {
  activa
  inactiva

  @@map("estado_empresa")
}

enum EstadoCuenta {
  activo
  baja

  @@map("estado_cuenta")
}

// Alcance base: un administrador único carga todo; Vigilancia solo consulta.
enum RolUsuario {
  administrador
  vigilancia

  @@map("rol_usuario")
}

enum TipoDocumentoIdentidad {
  DNI
  CE
  PASAPORTE

  @@map("tipo_documento_identidad")
}

enum EstadoPersona {
  activo
  inactivo

  @@map("estado_persona")
}

enum TipoMovimiento {
  ingreso
  salida

  @@map("tipo_movimiento")
}

enum ResultadoAcceso {
  autorizado
  denegado

  @@map("resultado_acceso")
}

enum AccionAuditoria {
  crear
  modificar
  eliminar

  @@map("accion_auditoria")
}

// ---------------------------------------------------------------------
// EMPRESA (proveedor / cliente, incluye OTP/MAS como una empresa más)
// ---------------------------------------------------------------------
model Empresa {
  id                     Int           @id @default(autoincrement())
  ruc                    String        @unique @db.VarChar(11)
  razonSocial            String        @map("razon_social") @db.VarChar(200)
  correoContacto         String        @map("correo_contacto") @db.VarChar(150)
  telefonoContacto       String?       @map("telefono_contacto") @db.VarChar(20)
  estado                 EstadoEmpresa @default(activa)
  contratoVigenciaInicio DateTime?     @map("contrato_vigencia_inicio") @db.Date
  contratoVigenciaFin    DateTime?     @map("contrato_vigencia_fin") @db.Date
  creadoEn               DateTime      @default(now()) @map("creado_en")
  actualizadoEn          DateTime      @default(now()) @updatedAt @map("actualizado_en")

  usuarios          Usuario[]
  personas          Persona[]

  @@map("empresa")
}

// ---------------------------------------------------------------------
// USUARIO (administrador o vigilancia — personal interno de OTP/MAS)
// Sin invitación por correo: las cuentas las crea el administrador.
// ---------------------------------------------------------------------
model Usuario {
  id           Int          @id @default(autoincrement())
  empresaId    Int          @map("empresa_id")
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  rol          RolUsuario
  correo       String       @unique @db.VarChar(150)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  estadoCuenta EstadoCuenta @default(activo) @map("estado_cuenta")
  creadoEn     DateTime     @default(now()) @map("creado_en")
  /// Último cambio de contraseña: las sesiones iniciadas antes dejan de valer.
  passwordCambiadoEn DateTime? @map("password_cambiado_en")

  auditorias Auditoria[]

  @@index([empresaId])
  @@map("usuario")
}

// ---------------------------------------------------------------------
// PERSONA (trabajador). Alcance base: sin perfiles ni puestos — el
// administrador registra empresa, trabajador y documentos, nada más.
// ---------------------------------------------------------------------
model Persona {
  id                     Int                    @id @default(autoincrement())
  empresaId              Int                    @map("empresa_id")
  empresa                Empresa                @relation(fields: [empresaId], references: [id])
  tipoDocumentoIdentidad TipoDocumentoIdentidad @map("tipo_documento_identidad")
  numeroDocumento        String                 @map("numero_documento") @db.VarChar(20)
  nombres                String                 @db.VarChar(150)
  apellidos              String                 @db.VarChar(150)
  // Foto para el reconocimiento facial del terminal ZKTeco (ruta en disco).
  fotoUrl                String?                @map("foto_url") @db.VarChar(500)
  estado                 EstadoPersona          @default(activo)
  creadoEn               DateTime               @default(now()) @map("creado_en")

  documentos        DocumentoPersona[]
  eventosAcceso     EventoAcceso[]

  // Global: una persona pertenece a una sola empresa a la vez
  @@unique([tipoDocumentoIdentidad, numeroDocumento])
  @@index([empresaId])
  @@index([numeroDocumento])
  @@map("persona")
}

// ---------------------------------------------------------------------
// TIPO_DOCUMENTO (nombres de documento: SCTR, Inducción, etc.). El
// administrador los agrega al subir un documento. Si un documento vence o no
// lo define su fecha de vencimiento (vacía = no vence).
// ---------------------------------------------------------------------
model TipoDocumento {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)

  documentos DocumentoPersona[]

  @@map("tipo_documento")
}

// ---------------------------------------------------------------------
// DOCUMENTO_PERSONA (historial completo, nunca se borra)
// Alcance base: sin aprobación — lo carga el administrador y ya es válido.
// La vigencia se calcula contra fechaVencimiento; cuenta la última versión.
// ---------------------------------------------------------------------
model DocumentoPersona {
  id               Int           @id @default(autoincrement())
  personaId        Int           @map("persona_id")
  persona          Persona       @relation(fields: [personaId], references: [id])
  tipoDocumentoId  Int           @map("tipo_documento_id")
  tipoDocumento    TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  fechaEmision     DateTime?     @map("fecha_emision") @db.Date
  fechaVencimiento DateTime?     @map("fecha_vencimiento") @db.Date
  archivoUrl       String?       @map("archivo_url") @db.VarChar(500)
  version          Int           @default(1)
  creadoEn         DateTime      @default(now()) @map("creado_en")

  @@index([personaId])
  @@index([personaId, tipoDocumentoId, version])
  @@map("documento_persona")
}

// ---------------------------------------------------------------------
// EVENTO_ACCESO (ingreso / salida por torniquete)
// Booleanos de denegación en vez de un solo motivo: un evento puede
// denegarse por alcohol y documentos a la vez, y una baja deniega de
// inmediato sin evaluar lo demás. Sin antipassback (alcance base): la
// salida siempre se registra como autorizada.
// ---------------------------------------------------------------------
model EventoAcceso {
  id                       Int             @id @default(autoincrement())
  /// Vacío si el documento no está registrado (intento de una persona desconocida).
  personaId                Int?            @map("persona_id")
  persona                  Persona?        @relation(fields: [personaId], references: [id], onDelete: Restrict)
  /// Documento con el que se identificó (lo que leyó el equipo), registrado o no.
  tipoDocumentoIdentidad   TipoDocumentoIdentidad? @map("tipo_documento_identidad")
  numeroDocumento          String?         @map("numero_documento") @db.VarChar(20)
  tipoMovimiento           TipoMovimiento  @map("tipo_movimiento")
  resultado                ResultadoAcceso
  denegadoNoRegistrado     Boolean         @default(false) @map("denegado_no_registrado")
  denegadoPorBaja          Boolean         @default(false) @map("denegado_por_baja")
  denegadoPorAlcohol       Boolean         @default(false) @map("denegado_por_alcohol")
  denegadoPorDocumentos    Boolean         @default(false) @map("denegado_por_documentos")
  denegadoSinDocumentos    Boolean         @default(false) @map("denegado_sin_documentos")
  fechaHora                DateTime        @default(now()) @map("fecha_hora")
  torniqueteId             String?         @map("torniquete_id") @db.VarChar(50)

  @@index([personaId, fechaHora])
  @@index([fechaHora])
  @@map("evento_acceso")
}

// ---------------------------------------------------------------------
// AUDITORIA (quién creó/modificó/aprobó cada registro)
// ---------------------------------------------------------------------
model Auditoria {
  id            Int             @id @default(autoincrement())
  usuarioId     Int?            @map("usuario_id")
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id])
  tablaAfectada String          @map("tabla_afectada") @db.VarChar(50)
  registroId    Int             @map("registro_id")
  accion        AccionAuditoria
  fechaHora     DateTime        @default(now()) @map("fecha_hora")

  @@index([tablaAfectada, registroId])
  @@index([fechaHora])
  @@map("auditoria")
}
