// Prisma schema — Sistema de Control de Acceso, Terminal de Mollendo
// Alcance base: ver Especificacion_Desarrollo_Control_Acceso_Mollendo_base.md (sección 8)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums (reflejan los CHECK constraints del script SQL original)
// ---------------------------------------------------------------------

enum EstadoEmpresa {
  activa
  inactiva

  @@map("estado_empresa")
}

enum EstadoCuenta {
  activo
  baja

  @@map("estado_cuenta")
}

// Alcance base: un administrador único carga todo; Vigilancia solo consulta.
enum RolUsuario {
  administrador
  vigilancia

  @@map("rol_usuario")
}

enum TipoDocumentoIdentidad {
  DNI
  CE
  PASAPORTE

  @@map("tipo_documento_identidad")
}

enum EstadoPersona {
  activo
  inactivo

  @@map("estado_persona")
}

/// Perfil de la persona: solo la clasifica (lista, Dashboard, reportes); no cambia lo que se valida en el molinete.
enum PerfilPersona {
  planta
  contratista
  subcontratista
  conductor
  visita
  cliente

  @@map("perfil_persona")
}

enum TipoMovimiento {
  ingreso
  salida

  @@map("tipo_movimiento")
}

enum ResultadoAcceso {
  autorizado
  denegado

  @@map("resultado_acceso")
}

enum AccionAuditoria {
  crear
  modificar
  eliminar
  /// Inicio de sesión correcto en el portal.
  inicio_sesion
  /// Intento de inicio de sesión rechazado (correo o contraseña incorrectos, o cuenta de baja).
  inicio_sesion_fallido

  @@map("accion_auditoria")
}

// ---------------------------------------------------------------------
// EMPRESA (proveedor / cliente, incluye OTP/MAS como una empresa más)
// ---------------------------------------------------------------------
model Empresa {
  id                     Int           @id @default(autoincrement())
  ruc                    String        @unique @db.VarChar(11)
  razonSocial            String        @map("razon_social") @db.VarChar(200)
  correoContacto         String        @map("correo_contacto") @db.VarChar(150)
  telefonoContacto       String?       @map("telefono_contacto") @db.VarChar(20)
  estado                 EstadoEmpresa @default(activa)
  contratoVigenciaInicio DateTime?     @map("contrato_vigencia_inicio") @db.Date
  contratoVigenciaFin    DateTime?     @map("contrato_vigencia_fin") @db.Date
  creadoEn               DateTime      @default(now()) @map("creado_en")
  actualizadoEn          DateTime      @default(now()) @updatedAt @map("actualizado_en")

  usuarios Usuario[]
  personas Persona[]

  @@map("empresa")
}

// ---------------------------------------------------------------------
// USUARIO (administrador o vigilancia — personal interno de OTP/MAS)
// Sin invitación por correo: las cuentas las crea el administrador.
// ---------------------------------------------------------------------
model Usuario {
  id                 Int          @id @default(autoincrement())
  empresaId          Int          @map("empresa_id")
  empresa            Empresa      @relation(fields: [empresaId], references: [id])
  rol                RolUsuario
  correo             String       @unique @db.VarChar(150)
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  estadoCuenta       EstadoCuenta @default(activo) @map("estado_cuenta")
  creadoEn           DateTime     @default(now()) @map("creado_en")
  /// Último cambio de contraseña: las sesiones iniciadas antes dejan de valer.
  passwordCambiadoEn DateTime?    @map("password_cambiado_en")

  auditorias                  Auditoria[]
  /// Ingresos que aprobó o denegó en la verificación manual.
  eventosVerificados          EventoAcceso[]              @relation("VerificadoPor")
  verificacionManualActivada  PeriodoVerificacionManual[] @relation("ActivadaPor")
  verificacionManualTerminada PeriodoVerificacionManual[] @relation("TerminadaPor")

  @@index([empresaId])
  @@map("usuario")
}

// ---------------------------------------------------------------------
// PERSONA (trabajador). Alcance base: sin perfiles ni puestos — el
// administrador registra empresa, trabajador y documentos, nada más.
// ---------------------------------------------------------------------
model Persona {
  id                     Int                    @id @default(autoincrement())
  empresaId              Int                    @map("empresa_id")
  empresa                Empresa                @relation(fields: [empresaId], references: [id])
  tipoDocumentoIdentidad TipoDocumentoIdentidad @map("tipo_documento_identidad")
  numeroDocumento        String                 @map("numero_documento") @db.VarChar(20)
  nombres                String                 @db.VarChar(150)
  apellidos              String                 @db.VarChar(150)
  // Foto para el reconocimiento facial del terminal ZKTeco (ruta en disco).
  fotoUrl                String?                @map("foto_url") @db.VarChar(500)
  estado                 EstadoPersona          @default(activo)
  /// Vacío en las personas registradas antes de que existiera el perfil ("Sin perfil").
  perfil                 PerfilPersona?
  /// Por qué se la dio de baja (opcional) y cuándo; se borran al reactivarla.
  motivoBaja             String?                @map("motivo_baja") @db.VarChar(300)
  fechaBaja              DateTime?              @map("fecha_baja")
  creadoEn               DateTime               @default(now()) @map("creado_en")

  documentos         DocumentoPersona[]
  eventosAcceso      EventoAcceso[]
  ingresosPendientes IngresoPendiente[]

  // Global: una persona pertenece a una sola empresa a la vez
  @@unique([tipoDocumentoIdentidad, numeroDocumento])
  @@index([empresaId])
  @@index([numeroDocumento])
  @@index([perfil])
  @@map("persona")
}

// ---------------------------------------------------------------------
// TIPO_DOCUMENTO (nombres de documento: SCTR, Inducción, etc.). El
// administrador los agrega al subir un documento. Si un documento vence o no
// lo define su fecha de vencimiento (vacía = no vence).
// ---------------------------------------------------------------------
model TipoDocumento {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)

  documentos DocumentoPersona[]

  @@map("tipo_documento")
}

// ---------------------------------------------------------------------
// DOCUMENTO_PERSONA (historial completo, nunca se borra)
// Alcance base: sin aprobación — lo carga el administrador y ya es válido.
// La vigencia se calcula contra fechaVencimiento; cuenta la última versión.
// ---------------------------------------------------------------------
model DocumentoPersona {
  id               Int           @id @default(autoincrement())
  personaId        Int           @map("persona_id")
  persona          Persona       @relation(fields: [personaId], references: [id])
  tipoDocumentoId  Int           @map("tipo_documento_id")
  tipoDocumento    TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  fechaEmision     DateTime?     @map("fecha_emision") @db.Date
  fechaVencimiento DateTime?     @map("fecha_vencimiento") @db.Date
  archivoUrl       String?       @map("archivo_url") @db.VarChar(500)
  version          Int           @default(1)
  creadoEn         DateTime      @default(now()) @map("creado_en")

  @@index([personaId])
  @@index([personaId, tipoDocumentoId, version])
  @@map("documento_persona")
}

// ---------------------------------------------------------------------
// EVENTO_ACCESO (ingreso / salida por torniquete)
// Booleanos de denegación en vez de un solo motivo: un evento puede
// denegarse por alcohol y documentos a la vez, y una baja deniega de
// inmediato sin evaluar lo demás. Sin antipassback (alcance base): la
// salida siempre se registra como autorizada.
// ---------------------------------------------------------------------
model EventoAcceso {
  id                       Int                     @id @default(autoincrement())
  /// Vacío si el documento no está registrado (intento de una persona desconocida).
  personaId                Int?                    @map("persona_id")
  persona                  Persona?                @relation(fields: [personaId], references: [id], onDelete: Restrict)
  /// Documento con el que se identificó (lo que leyó el equipo), registrado o no.
  tipoDocumentoIdentidad   TipoDocumentoIdentidad? @map("tipo_documento_identidad")
  numeroDocumento          String?                 @map("numero_documento") @db.VarChar(20)
  tipoMovimiento           TipoMovimiento          @map("tipo_movimiento")
  resultado                ResultadoAcceso
  denegadoNoRegistrado     Boolean                 @default(false) @map("denegado_no_registrado")
  denegadoPorBaja          Boolean                 @default(false) @map("denegado_por_baja")
  denegadoPorAlcohol       Boolean                 @default(false) @map("denegado_por_alcohol")
  denegadoPorDocumentos    Boolean                 @default(false) @map("denegado_por_documentos")
  denegadoSinDocumentos    Boolean                 @default(false) @map("denegado_sin_documentos")
  /// Pasó su DNI en regla pero no completó rostro y alcohol en el G4 Pro a tiempo.
  denegadoSinVerificacion  Boolean                 @default(false) @map("denegado_sin_verificacion")
  /// Verificación manual: el vigilante indicó que el rostro no es el de la foto registrada.
  denegadoRostroNoCoincide Boolean                 @default(false) @map("denegado_rostro_no_coincide")
  /// Antipassback: quiso ingresar, pero su último movimiento es un ingreso (no registró su salida).
  denegadoYaDentro         Boolean                 @default(false) @map("denegado_ya_dentro")
  /// Antipassback: quiso salir, pero no registra ingreso (su último movimiento es una salida, o no tiene).
  denegadoSinIngreso       Boolean                 @default(false) @map("denegado_sin_ingreso")
  /// Orden "facial primero" (permiso fijo): ingreso con rostro y alcohol aprobados en el G4 Pro y el DNI al final.
  /// El rtlog no dice quién aprobó; se lee del rastreo del equipo (dniQueSoplo). Si no se pudo, lo compara el vigilante.
  facialPrimero            Boolean                 @default(false) @map("facial_primero")
  /// Orden "facial primero": DNI de quien aprobó rostro y alcohol, según el rastreo del G4 Pro (VerifySuccess.txt).
  /// null: no se pudo saber (ingreso sin confirmar).
  dniQueSoplo              String?                 @map("dni_que_soplo") @db.VarChar(24)
  /// Orden "facial primero": el G4 Pro dice que sopló otra persona (dniQueSoplo) que la del DNI.
  denegadoNoEsQuienSoplo   Boolean                 @default(false) @map("denegado_no_es_quien_soplo")
  /// Orden "facial primero": pasó su DNI sin una aprobación de rostro y alcohol en los 20 s anteriores.
  denegadoSinFacial        Boolean                 @default(false) @map("denegado_sin_facial")
  /// Orden "facial primero": alguien aprobó rostro y alcohol, pero nadie pasó su DNI a tiempo (sin persona).
  denegadoSinDni           Boolean                 @default(false) @map("denegado_sin_dni")
  /// Rostro y alcohol los verificó un vigilante (equipo facial fuera de servicio), no el G4 Pro.
  verificacionManual       Boolean                 @default(false) @map("verificacion_manual")
  /// Movimiento registrado a mano por un vigilante o administrador para corregir el antipassback
  /// (p. ej. salió en una emergencia con los brazos liberados): no pasó por el molinete.
  correccionManual         Boolean                 @default(false) @map("correccion_manual")
  /// Por qué se corrigió (obligatorio en las correcciones manuales).
  motivoCorreccion         String?                 @map("motivo_correccion") @db.VarChar(300)
  /// Quién decidió en la verificación manual, o quién registró la corrección manual.
  verificadoPorId          Int?                    @map("verificado_por_id")
  verificadoPor            Usuario?                @relation("VerificadoPor", fields: [verificadoPorId], references: [id], onDelete: SetNull)
  fechaHora                DateTime                @default(now()) @map("fecha_hora")
  torniqueteId             String?                 @map("torniquete_id") @db.VarChar(50)

  verificacionesDispositivo VerificacionDispositivo[]

  @@index([personaId, fechaHora])
  @@index([fechaHora])
  @@map("evento_acceso")
}

// ---------------------------------------------------------------------
// INGRESO_PENDIENTE (DNI ya validado, esperando el resultado del G4 Pro)
// El G4 Pro abre el ingreso con su propio relé y no espera permiso de la
// mini PC (confirmado con el equipo real que no soporta ser "habilitado" por
// fecha/hora -- ver Analisis_Control_Acceso_Mollendo.md sección 6.0), así
// que el DNI y el resultado facial+alcohol llegan en dos momentos separados.
// Esta tabla es el puente: se crea al pasar el DNI y se consume cuando llega
// el rtlog correspondiente, correlacionado por cercanía de horario (el PIN
// que manda el rtlog no es confiable, ver VerificacionDispositivo).
// ---------------------------------------------------------------------
model IngresoPendiente {
  id                Int       @id @default(autoincrement())
  personaId         Int       @map("persona_id")
  persona           Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  torniqueteId      String?   @map("torniquete_id") @db.VarChar(50)
  creadoEn          DateTime  @default(now()) @map("creado_en")
  consumidoEn       DateTime? @map("consumido_en")
  /// Cuándo se le dio permiso de paso en el G4 Pro (null = en cola, esperando que termine la anterior).
  habilitadoEn      DateTime? @map("habilitado_en")
  /// Creada durante la verificación manual: la decide un vigilante (no se habilita en el G4 Pro).
  manual            Boolean   @default(false)
  /// Versión con E23 de "facial primero" (17/10/2026, hoy sin uso: rige la de permiso fijo). Se conservan las columnas.
  facialPrimero     Boolean   @default(false) @map("facial_primero")
  /// Orden "facial primero": cuándo aprobó rostro y alcohol (desde ahí tiene un minuto para pasar su DNI).
  alcoholAprobadoEn DateTime? @map("alcohol_aprobado_en")

  @@index([personaId, consumidoEn])
  @@map("ingreso_pendiente")
}

// ---------------------------------------------------------------------
// PERIODO_VERIFICACION_MANUAL (contingencia por falla del equipo facial)
// Mientras hay un periodo abierto (terminadoEn null), cada ingreso en regla lo
// aprueba un vigilante en el Panel. Ver docs/cliente/Contingencias_Equipos_Acceso.md, sección 4.
// ---------------------------------------------------------------------
model PeriodoVerificacionManual {
  id             Int       @id @default(autoincrement())
  motivo         String    @db.VarChar(300)
  activadoEn     DateTime  @default(now()) @map("activado_en")
  activadoPorId  Int?      @map("activado_por_id")
  activadoPor    Usuario?  @relation("ActivadaPor", fields: [activadoPorId], references: [id], onDelete: SetNull)
  terminadoEn    DateTime? @map("terminado_en")
  terminadoPorId Int?      @map("terminado_por_id")
  terminadoPor   Usuario?  @relation("TerminadaPor", fields: [terminadoPorId], references: [id], onDelete: SetNull)

  @@index([terminadoEn])
  @@map("periodo_verificacion_manual")
}

// ---------------------------------------------------------------------
// DISPOSITIVO_ACCESO (terminal ZKTeco G4 Pro, protocolo PUSH/ADMS)
// Un RegistryCode estable por equipo: el firmware del G4 Pro solo confía en
// el servidor y empieza a mandar datos reales si /iclock/registry responde
// "RegistryCode=<algo>" (nunca "OK"), y el mismo código debe repetirse en
// cada llamada del mismo equipo — confirmado con el equipo real
// HSR3263100192 (ver Analisis_Control_Acceso_Mollendo.md sección 6.1).
// ---------------------------------------------------------------------
model DispositivoAcceso {
  id              Int       @id @default(autoincrement())
  serialNumber    String    @unique @map("serial_number") @db.VarChar(30)
  registryCode    String    @map("registry_code") @db.VarChar(20)
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  /// IP del equipo en la red de la garita, la que informa al registrarse (IPAddress=…); ipAddress es la pública.
  ipLocal         String?   @map("ip_local") @db.VarChar(45)
  ultimaActividad DateTime? @map("ultima_actividad")
  creadoEn        DateTime  @default(now()) @map("creado_en")

  comandos       ComandoDispositivo[]
  verificaciones VerificacionDispositivo[]

  @@map("dispositivo_acceso")
}

enum EstadoComando {
  pendiente
  entregado
  confirmado

  @@map("estado_comando")
}

// ---------------------------------------------------------------------
// COMANDO_DISPOSITIVO (cola de ordenes al equipo, ej. DATA UPDATE USERINFO)
// El equipo las recoge al llamar /iclock/getrequest y confirma el resultado
// por /iclock/devicecmd.
// ---------------------------------------------------------------------
model ComandoDispositivo {
  id            Int               @id @default(autoincrement())
  dispositivoId Int               @map("dispositivo_id")
  dispositivo   DispositivoAcceso @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  comando       String            @db.Text
  estado        EstadoComando     @default(pendiente)
  returnCode    Int?              @map("return_code")
  creadoEn      DateTime          @default(now()) @map("creado_en")
  entregadoEn   DateTime?         @map("entregado_en")
  confirmadoEn  DateTime?         @map("confirmado_en")

  @@index([dispositivoId, estado])
  @@map("comando_dispositivo")
}

// ---------------------------------------------------------------------
// VERIFICACION_DISPOSITIVO (eventos en tiempo real del G4 Pro: table=rtlog
// con el resultado facial+alcoholimetro, table=rtstate con el estado de
// sensor/rele/puerta). Ninguna de las dos tablas esta documentada por el
// fabricante -- se descubrieron reversando trafico real del equipo
// HSR3263100192 (ver Analisis_Control_Acceso_Mollendo.md seccion 6.1).
// El campo "pin" que manda el equipo en rtlog no es confiable (llega en 0
// incluso con un usuario real enrolado), asi que la correlacion con la
// persona que paso su DNI se hace por cercania de horario, no por este
// campo -- de ahi que eventoAccesoId quede opcional.
// ---------------------------------------------------------------------
model VerificacionDispositivo {
  id              Int               @id @default(autoincrement())
  dispositivoId   Int               @map("dispositivo_id")
  dispositivo     DispositivoAcceso @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  tabla           String            @db.VarChar(20)
  horaDispositivo DateTime?         @map("hora_dispositivo")
  eventCode       String?           @map("event_code") @db.VarChar(10)
  verifyType      String?           @map("verify_type") @db.VarChar(10)
  concentracion   String?           @db.VarChar(20)
  crudo           String            @db.Text
  eventoAccesoId  Int?              @map("evento_acceso_id")
  eventoAcceso    EventoAcceso?     @relation(fields: [eventoAccesoId], references: [id], onDelete: SetNull)
  creadoEn        DateTime          @default(now()) @map("creado_en")

  @@index([dispositivoId, creadoEn])
  @@map("verificacion_dispositivo")
}

// ---------------------------------------------------------------------
// AUDITORIA (quién creó/modificó/aprobó cada registro)
// ---------------------------------------------------------------------
model Auditoria {
  id            Int             @id @default(autoincrement())
  usuarioId     Int?            @map("usuario_id")
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id])
  tablaAfectada String          @map("tabla_afectada") @db.VarChar(50)
  registroId    Int             @map("registro_id")
  accion        AccionAuditoria
  fechaHora     DateTime        @default(now()) @map("fecha_hora")
  /// Dirección IP desde donde se hizo (inicios de sesión).
  ip            String?         @db.VarChar(45)
  /// Detalle del intento: el correo escrito y por qué se rechazó (inicios de sesión).
  detalle       String?         @db.VarChar(200)

  @@index([tablaAfectada, registroId])
  @@index([fechaHora])
  @@map("auditoria")
}

// ---------------------------------------------------------------------
// SINCRONIZACION_G4 (cada sincronización con los G4 Pro, manual o diaria)
// Se guarda para que "Sistema y APIs" muestre la última aunque la API se
// reinicie. `resultado` lleva el detalle (equipos, agregadas, borradas,
// permisos quitados, usuarios a borrar y usuarios/rostros por equipo).
// ---------------------------------------------------------------------
// ---------------------------------------------------------------------
// AJUSTE_SISTEMA (ajustes que cambia el administrador desde el portal)
// "orden_ingreso": "dni-primero" (normal) o "facial-primero" (en prueba).
// ---------------------------------------------------------------------
model AjusteSistema {
  id            Int      @id @default(autoincrement())
  clave         String   @unique @db.VarChar(50)
  valor         String   @db.VarChar(100)
  modificadoEn  DateTime @updatedAt @map("modificado_en")
  /// Correo de quien lo cambió (el detalle queda en la auditoría).
  modificadoPor String?  @map("modificado_por") @db.VarChar(150)

  @@map("ajuste_sistema")
}

model SincronizacionG4 {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @default(now())
  /// "manual" (botón o POST /integraciones/g4pro/sincronizar) o "diaria".
  origen     String   @db.VarChar(10)
  simulacion Boolean  @default(false)
  /// Mensaje si falló (null si terminó bien).
  error      String?
  resultado  Json

  @@index([fecha])
  @@map("sincronizacion_g4")
}
