# Entorno LOCAL — PC de desarrollo. Copiar como mollendo-api/.env.
# Los servidores usan otras plantillas: deploy/nube.env.example, deploy/controlador.env.example
# y deploy/garita.env.example (ver Registro_Despliegue_MiniPC.md, "Entornos").

# Base de datos (PostgreSQL) — ver sección 5 de la especificación
DATABASE_URL="postgresql://usuario:password@localhost:5433/mollendo_control_acceso?schema=public"

# Autenticación
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT="3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Almacenamiento de documentos (disco del propio servidor, según spec sección 2)
DOCUMENTOS_STORAGE_PATH="./storage/documentos"

# Seed inicial: administrador único (las demás cuentas las crea él desde "Usuarios")
ADMIN_SEED_RUC="00000000000"
ADMIN_SEED_EMAIL="admin@mollendo.local"
ADMIN_SEED_PASSWORD="cambiar-por-una-contraseña-segura"

# Cuenta de Vigilancia inicial
VIGILANCIA_SEED_EMAIL="vigilancia@mollendo.local"
VIGILANCIA_SEED_PASSWORD="cambiar-por-una-contraseña-segura"

# Clave compartida para los equipos físicos (ZKBio CVSecurity / terminal ZKTeco, molinete)
DEVICE_API_KEY="cambiar-por-una-clave-larga-y-aleatoria"

# Igual que la nube: los molinetes están en el controlador de la garita (en local se ven "Desconectado").
MOLINETES_REMOTOS="true"
# Sin sincronización diaria con los G4 Pro en desarrollo (sigue disponible la manual).
G4PRO_HORA_SINCRONIZACION="off"
