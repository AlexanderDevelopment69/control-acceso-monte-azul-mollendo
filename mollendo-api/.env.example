# Base de datos (PostgreSQL) — ver sección 5 de la especificación
DATABASE_URL="postgresql://usuario:password@localhost:5433/mollendo_control_acceso?schema=public"

# Autenticación
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio"
JWT_REFRESH_EXPIRES_IN="7d"

# Correo (SMTP) — usar Mailtrap/Ethereal en desarrollo, definir proveedor real en producción
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@mollendo.local"

# Servidor
PORT="3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Almacenamiento de documentos (disco del propio servidor, según spec sección 2)
DOCUMENTOS_STORAGE_PATH="./storage/documentos"

# Seed inicial (usuario de Administración, único bootstrap sin invitación)
ADMIN_SEED_RUC="00000000000"
ADMIN_SEED_EMAIL="admin@mollendo.local"
ADMIN_SEED_PASSWORD="cambiar-por-una-contraseña-segura"

# Cuentas DEMO (solo desarrollo) para probar los roles Vigilancia y Empresa
# sin pasar por el flujo de invitación por correo — no crear en producción
VIGILANCIA_SEED_EMAIL="vigilancia@mollendo.local"
VIGILANCIA_SEED_PASSWORD="cambiar-por-una-contraseña-segura"
EMPRESA_DEMO_RUC="20000000001"
EMPRESA_DEMO_EMAIL="empresa@mollendo.local"
EMPRESA_DEMO_PASSWORD="cambiar-por-una-contraseña-segura"

# Clave compartida para los equipos físicos (lector DNI, alcoholímetro, torniquete)
DEVICE_API_KEY="cambiar-por-una-clave-larga-y-aleatoria"
